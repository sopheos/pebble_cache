{
    "name": "sopheos/pebble_cache",
    "description": "PSR-16 caches (Memcached, in-memory), token bucket rate limiter and session handler",
    "license": "MIT",
    "require": {
        "php": ">=8.1.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "ext-memcached": "Required by Pebble\\Cache\\MemCache"
    },
    "autoload": {
        "psr-4": {
            "Pebble\\Cache\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
